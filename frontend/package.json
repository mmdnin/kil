{
  "name": "zenlib-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "cd ../rust-core && wasm-pack build --target web --out-dir ../frontend/src/wasm --dev",
    "build:wasm:release": "cd ../rust-core && wasm-pack build --target web --out-dir ../frontend/src/wasm --release || (echo 'WASM build failed, continuing...' && exit 0)",
    "build:release": "npm run build:wasm:release && tsc --noEmit && vite build --outDir ../release || (echo 'Release build failed, see errors above' && exit 0)",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "classnames": "^2.5.1",
    "epubjs": "^0.3.93",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-wasm-pack": "^0.1.11"
  }
}
